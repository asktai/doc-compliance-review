#!/bin/sh
# 铁律自检 · pre-commit 钩子（**只警告、不阻断**）
# ---------------------------------------------------------------
# 由 maint/tools/check-dev-rules.py --install-hook 安装。
# 本文件受 git 跟踪（源码在 maint/tools/hooks/pre-commit），换机器重装即可。
#
# 设计：只在本次提交**涉及铁律或其守卫**时才跑，且无论结果如何都 exit 0
#       （不阻断提交）——理由是脚本自身也可能有 bug，不该让它卡死工作流。
#       要强制门禁，请手动运行脚本并查看退出码（可用于 CI）。
#
# 触发面（三档）：
#   一档 · 铁律正文改动（DEV-RULES.md）              → 跑自检（十四维）
#   二档 · 守卫本体改动（check-dev-rules.py／冒烟脚本／分离守卫）→ 跑**全量冒烟**
#         理由：改了守卫，光"跑通"不够，须用注入测试证明它**仍然拦得住**；
#         否则就是铁律 10.5.2 说的"摆样子"——放在永远触发不到的位置。
#   三档 · 技能目录内容改动（doc-compliance-review/**）→ 跑**分离守卫**
#         理由：防开发资料混入随包目录、防未登记素材随包（铁律第 7 条）。
#         这一步是"忘了登记"的第一道自动提示——不必等打包才发现。
set -u

repo_root=$(git rev-parse --show-toplevel 2>/dev/null || echo .)
cd "$repo_root" || exit 0

staged=$(git diff --cached --name-only)
if [ -z "$staged" ]; then
    exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
    exit 0
fi

# ── 一档：铁律正文改动 → 自检 ──
if printf '%s\n' "$staged" | grep -q '^DEV-RULES.md$'; then
    echo "[hook] 检测到 DEV-RULES.md 改动，运行铁律自检（只警告、不阻断）…"
    python3 maint/tools/check-dev-rules.py || true
fi

# ── 二档：守卫本体改动 → 全量冒烟（证明守卫仍拦得住）──
if printf '%s\n' "$staged" | grep -qE '^maint/tools/(check-dev-rules|smoke-dev-rules|check-separation)\.py$'; then
    echo "[hook] 检测到守卫本体改动，运行铁律全量冒烟（只警告、不阻断）…"
    python3 maint/tools/smoke-dev-rules.py || true
fi

# ── 三档：技能目录内容改动 → 分离守卫（防混入／防未登记素材随包）──
if printf '%s\n' "$staged" | grep -qE '^doc-compliance-review/'; then
    echo "[hook] 检测到技能目录改动，运行分离守卫（只警告、不阻断）…"
    python3 maint/tools/check-separation.py || true
fi

exit 0
