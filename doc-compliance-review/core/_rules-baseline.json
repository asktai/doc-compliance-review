        "name": "终止后义务缺失（下架销毁、数据移交、员工撤离）",
        "level": 1,
        "section": "二、跨类型通用规则"
      },
      {
        "id": "T5",
        "name": "在库/在制品/未履行订单处理缺失",
        "level": 1,
        "section": "二、跨类型通用规则"
      },
      {
        "id": "W1",
        "name": "错别字/别字（同音、形近；影响权利义务的）",
        "level": 1,
        "section": "二、跨类型通用规则"
      },
      {
        "id": "W2",
        "name": "标点错误（中英标点混用、成对标点缺失/不配对、书名号误用）",
        "level": 1,
        "section": "二、跨类型通用规则"
      },
      {
        "id": "W3",
        "name": "病句/歧义（成分残缺、搭配不当、指代不明、逻辑矛盾）",
        "level": 1,
        "section": "二、跨类型通用规则"
      },
      {
        "id": "W4",
        "name": "笔误（金额/数量/日期/比例/期限误写或前后不一致；大小写金额不符）",
        "level": 3,
        "section": "二、跨类型通用规则"
      },
      {
        "id": "W5",
        "name": "主体称谓/简称前后不统一、「甲/乙方」等角色指代混乱（非合同类为授权人/承诺人/发布方/员工等）",
        "level": 2,
        "section": "二、跨类型通用规则"
      },
      {
        "id": "W6",
        "name": "条款/章节编号与交叉引用错误（跳号、引用不存在条号、附件或附表编号不符）",
        "level": 2,
        "section": "二、跨类型通用规则"
      },
      {
        "id": "W7",
        "name": "格式瑕疵（空白未填/占位符未替换/份数/骑缝/签章或发布栏处空白）",
        "level": 2,
        "section": "二、跨类型通用规则"
      },
      {
        "id": "W8",
        "name": "模糊/口语表述（\"及时/尽量/合理/适当/尽快/酌情\"等不可量化）",
        "level": 2,
        "section": "二、跨类型通用规则"
      },
      {
        "id": "F1",
        "name": "**性质错配（低估）**：名为承诺函/备忘录/告知/纪要，实含对价与双方权利义务条款",
        "level": 3,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F2",
        "name": "授权书/委托书授权范围笼统（全权、一切事宜）",
        "level": 3,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F3",
        "name": "授权书未设有效期或起止日不明",
        "level": 2,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F4",
        "name": "授权书未写明可否转委托",
        "level": 2,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F5",
        "name": "授权书缺授权人签章或被授权人身份信息",
        "level": 3,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F6",
        "name": "承诺/担保函未明示担保性质（仅写担保、负责）",
        "level": 3,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F7",
        "name": "承诺函生效要件与撤回机制不明",
        "level": 2,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F8",
        "name": "告知/声明缺送达与签收留痕机制",
        "level": 2,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F9",
        "name": "告知/声明以格式条款免除己方法定义务",
        "level": 3,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F10",
        "name": "制度/政策缺生效日期、版本号、旧版废止条款",
        "level": 2,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F11",
        "name": "制度/政策适用范围与效力层级不明",
        "level": 3,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F12",
        "name": "涉员工切身利益的制度未经民主程序或未公示",
        "level": 3,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F13",
        "name": "文档缺签署主体、日期或印章",
        "level": 2,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F14",
        "name": "非合同文档被引用为主合同附件却无关联标识",
        "level": 2,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F15",
        "name": "文档含个人信息处理但无授权与合规提示",
        "level": 2,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F16",
        "name": "保密协议(NDA)：保密信息定义过宽（“一切信息”）或过窄",
        "level": 2,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F17",
        "name": "NDA 保密期限缺失或过短",
        "level": 2,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F18",
        "name": "NDA 未限定人员范围与转披露",
        "level": 2,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F19",
        "name": "NDA 缺违约救济与返还/销毁条款",
        "level": 2,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F20",
        "name": "数据处理协议(DPA)：未界定处理目的、范围与期限",
        "level": 3,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F21",
        "name": "DPA 未约定子处理者与再委托",
        "level": 2,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F22",
        "name": "DPA 未约定数据主体权利协助与安全措施",
        "level": 3,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F23",
        "name": "DPA 未约定数据泄露通知时限",
        "level": 3,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F24",
        "name": "DPA 跨境传输无合法性基础",
        "level": 3,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F25",
        "name": "DPA 终止后未约定删除/返还",
        "level": 2,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F26",
        "name": "SLA/服务协议：服务范围与指标不量化",
        "level": 3,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F27",
        "name": "SLA 未达标无救济（服务抵扣/终止权）",
        "level": 2,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F28",
        "name": "**性质错配（高估）**：实为单方/陈述性文件（通知、告知、说明、纪要、报告、内部制度），却被套用合同框架——要求补设违约责任、管辖、对价，或虚构\"甲/乙方\"指代",
        "level": 2,
        "section": "三、评级校准案例(few-shot)"
      },
      {
        "id": "F29",
        "name": "**混合型文件未分层**：同一份文件内合同正文与非合同附件（保密制度/SLA/告知书/承诺函）并存，却整份只用一套审查口径",
        "level": 2,
        "section": "三、评级校准案例(few-shot)"
      }
    ]
  },
