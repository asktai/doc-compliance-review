          "pattern": "相关法律法规",
          "note": "建议：点名具体法条（本技能有法规库可查）"
        },
        {
          "pattern": "有关部门",
          "note": "建议：写明主管机关名称"
        },
        {
          "pattern": "根据相关(规定|法律)",
          "note": "建议：引用具体条文号"
        },
        {
          "pattern": "(依法|依规)追究.{0,6}责任",
          "note": "建议：写明请求权基础与责任形式"
        }
      ]
