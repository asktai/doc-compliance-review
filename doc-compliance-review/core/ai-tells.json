    {
      "id": "C",
      "name": "模板化句式",
      "severity": "mid",
      "description": "模型爱用的排比/三段式框架句——出现即提示「可能是凑结构」",
      "patterns": [
        {
          "pattern": "首先.{0,60}其次.{0,60}(最后|再次)",
          "note": "三段式排比（同一段内）"
        },
        {
          "pattern": "一方面.{0,80}另一方面",
          "note": "对仗式填充（同一段内）"
        },
        {
          "pattern": "不仅.{1,40}而且.{1,40}更",
          "note": "递进三连（同一段内）"
        },
        {
          "pattern": "(需要|值得注意的是)，.{4,30}(并非|不是).{2,20}(而是|而是要)",
          "note": "先破后立框架句"
        },
        {
          "pattern": "这(不仅|不但)．{0,4}(体现|反映)了",
          "note": "拔高式评论开头"
        }
