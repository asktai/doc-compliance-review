    {
      "id": "X",
      "name": "格式特征",
      "severity": "low",
      "description": "低置信特征，仅提示——高频出现时才值得人工看一眼",
      "patterns": [
        {
          "pattern": "[，。！？；：]{0}、(?=[^\\s])",
          "note": "顿号连用无空隙（仅低置信）"
        },
        {
          "pattern": "（注：.{0,40}）$",
          "note": "括注式补充（模型爱用，人类编辑常删）"
